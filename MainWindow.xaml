<Window x:Class="Lab1_BAI_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transport Application"
        Height="450"
        Width="500">

    <Grid Margin="10">

        <StackPanel>

            <TextBlock Text="Transport Type"/>
            <ComboBox x:Name="TransportBox">
                <ComboBoxItem Content="Bicycle"/>
                <ComboBoxItem Content="Car"/>
                <ComboBoxItem Content="Truck"/>
            </ComboBox>

            <TextBlock Text="Model"/>
            <TextBox x:Name="ModelBox"/>

            <TextBlock Text="Average Speed"/>
            <TextBox x:Name="SpeedBox"/>

            <TextBlock Text="Passengers"/>
            <TextBox x:Name="PassengersBox"/>

            <TextBlock Text="Distance"/>
            <TextBox x:Name="DistanceBox"/>

            <Button Content="Calculate"
                    Click="Calculate_Click"
                    Margin="0,10,0,10"/>

            <TextBlock x:Name="ResultBlock"
                       TextWrapping="Wrap"
                       FontSize="14"/>

        </StackPanel>

    </Grid>
</Window>